[Unit]
Description=Lingxing OMS parcel outbound sync (one-shot, last 3 days)
After=network-online.target mysql.service
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/opt/baseline
ExecStart=/opt/baseline/venv/bin/python "/opt/baseline/oms/oms packages/oms_outbound_sync.py" --days 3
